# TWS / IB Gateway connection
TWS_HOST=127.0.0.1
TWS_PORT=7497
TWS_CLIENT_ID=21
TWS_PAPER_ACCOUNT=DU1234567

# Safe default: read_only | paper | live
IBKR_AGENT_MODE=read_only

# Required in addition to IBKR_AGENT_MODE=live before order tools are registered.
IBKR_ALLOW_LIVE_TRADING=false
# Keep false unless compatibility with the original unguarded order tools is required.
IBKR_ENABLE_LEGACY_ORDER_TOOLS=false
IBKR_REQUIRE_ORDER_CONFIRMATION=true

# Conservative account/API budgets
IBKR_MARKET_DATA_LINES=100
IBKR_RESERVED_MARKET_DATA_LINES=20
IBKR_MAX_OPERATIONAL_STREAMS=40
IBKR_MAX_ORDER_NOTIONAL_USD=5000
IBKR_MAX_ORDERS_PER_DAY=20
IBKR_LIVE_STALE_AFTER_SECONDS=15
IBKR_DELAYED_STALE_AFTER_SECONDS=120

# Tick-by-tick radar. Default 100 market-data lines normally allow about 5 streams.
IBKR_TICK_RADAR_MAX_STREAMS=5
IBKR_TICK_RADAR_RETENTION_SECONDS=900
IBKR_TICK_RADAR_BASELINE_SECONDS=120
IBKR_TICK_RADAR_RECENT_SECONDS=5
IBKR_TICK_RADAR_FLOW_SECONDS=15
IBKR_TICK_RADAR_PRICE_SECONDS=30
IBKR_TICK_RADAR_MIN_BASELINE_SECONDS=30
IBKR_TICK_RADAR_LARGE_NOTIONAL_USD=100000
IBKR_TICK_RADAR_LARGE_Z=3.5
IBKR_TICK_RADAR_ALERT_SCORE=55
IBKR_TICK_RADAR_REARM_SCORE=35
IBKR_TICK_RADAR_ALERT_COOLDOWN_SECONDS=30
IBKR_TICK_RADAR_DECAY_FLOOR=20
IBKR_TICK_RADAR_INCLUDE_UNREPORTED=false
IBKR_TICK_RADAR_MIN_CALIBRATION_SAMPLES=20
IBKR_TICK_RADAR_STALE_AFTER_SECONDS=10

# Secure local defaults
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
IBKR_CORS_ORIGINS=http://localhost,http://127.0.0.1
